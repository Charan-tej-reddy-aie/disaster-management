# Dependencies
node_modules/
*/node_modules/
venv/
.venv/
env/

# Production build outputs
dist/
*/dist/
build/
*/build/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints

# Blockchain / Hardhat compilation artifacts
blockchain/artifacts/
blockchain/cache/

# Large deployment archives (avoids GitHub 100MB file limit)
*.tar.gz
*.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# LaTeX temporary files
*.synctex.gz
*.aux
*.out
*.toc

# Large raw datasets / processed data (avoids GitHub file size limit)
ml-service/data/

# Experimental pickle models (>100MB)
ml-service/models/*.pkl
*.bak

# Environment variables
.env
*.env.local

# OS files
.DS_Store
Thumbs.db
